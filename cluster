#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export ANSIBLE_CONFIG="$ROOT/ansible.cfg"
# Keep Ansible's controller cache out of the repository and support restricted workspaces.
export ANSIBLE_LOCAL_TEMP="${ANSIBLE_LOCAL_TEMP:-${TMPDIR:-/tmp}/kubernetes-ansible-$UID}"
usage() {
  cat <<'HELP'
Usage: ./cluster [setup|check|status|kubeconfig] [Ansible options]
  setup       Prepare clean Ubuntu nodes, create the cluster, verify readiness (default)
  check       Validate inventory and playbook syntax locally; no SSH or changes
  status      Show nodes and pods through the master; no cluster changes
  kubeconfig  Save admin kubeconfig to .local/kubeconfig with mode 0600
Examples:
  ./cluster setup -u ubuntu -K
  ./cluster setup -u ubuntu --private-key ~/.ssh/lab
  ./cluster status -u ubuntu -K
Override inventory with CLUSTER_INVENTORY=/path/to/hosts.
HELP
}
action="${1:-setup}"
if [[ $# -gt 0 ]]; then shift; fi
case "$action" in
  -h|--help|help) usage; exit 0 ;;
  setup|check|status|kubeconfig) ;;
  *) usage >&2; exit 2 ;;
esac
for command in ansible-playbook ansible-inventory; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "Missing $command. Install Ansible on the controller (Ubuntu: sudo apt-get install ansible)." >&2
    exit 127
  fi
done
inventory="${CLUSTER_INVENTORY:-$ROOT/kube-cluster/hosts-ubuntu}"
case "$action" in
  check)
    ansible-inventory -i "$inventory" --graph "$@"
    exec ansible-playbook -i "$inventory" "$ROOT/kube-cluster/ansible-playbook/cluster.yml" --syntax-check "$@"
    ;;
  setup) playbook=cluster ;;
  status) playbook=status ;;
  kubeconfig) playbook=kubeconfig ;;
esac
exec ansible-playbook -i "$inventory" "$ROOT/kube-cluster/ansible-playbook/$playbook.yml" "$@"
