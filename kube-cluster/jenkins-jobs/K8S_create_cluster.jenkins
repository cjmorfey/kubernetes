#!groovy
// Agent needs Ansible, verified SSH host keys and SSH/sudo credentials.
pipeline {
    agent { label 'controller' }
    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    stages {
        stage('Validate') { steps { sh './cluster check' } }
        stage('Create cluster') { steps { sh './cluster setup' } }
    }
}
