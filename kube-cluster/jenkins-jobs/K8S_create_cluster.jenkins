#!groovy
// Jenkins agent requires Ansible and SSH/sudo access to the Ubuntu inventory.
pipeline {
    agent { label 'controller' }
    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    stages {
        stage('Validate Ubuntu cluster playbook') {
            steps {
                sh 'ansible-playbook -i kube-cluster/hosts-ubuntu kube-cluster/ansible-playbook/cluster.yml --syntax-check'
            }
        }
        stage('Bootstrap Ubuntu cluster') {
            steps {
                sh 'ansible-playbook -i kube-cluster/hosts-ubuntu kube-cluster/ansible-playbook/cluster.yml'
            }
        }
    }
}
