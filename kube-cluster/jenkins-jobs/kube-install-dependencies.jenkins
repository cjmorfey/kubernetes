#!groovy
// Optional preparation only; normally use K8S_create_cluster.jenkins.
pipeline {
    agent { label 'controller' }
    options { disableConcurrentBuilds(); timestamps() }
    stages {
        stage('Prepare Ubuntu nodes') {
            steps {
                sh 'ansible-playbook -i kube-cluster/hosts-ubuntu kube-cluster/ansible-playbook/preparation-steps-ubuntu.yml'
            }
        }
    }
}
